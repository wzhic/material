{
  "name": "desktop",
  "productName": "Material 素材分析",
  "version": "1.0.0",
  "description": "本地优先的广告素材分析桌面客户端",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests-with-diagnostic.mjs",
    "test:codex-runtime": "vitest run src/codex-subscription/runtime.test.ts src/codex-subscription/codex.runtime.test.ts --reporter=verbose",
    "test:learned-runtime": "vitest run src/media-tools/learned-runtime.test.ts src/media-tools/learned-runtime-bundle.test.ts src/media-tools/learned-runtime-builder.test.ts src/media-tools/learned-runtime-configuration.test.ts --reporter=verbose && node scripts/run-python-runtime-tests.mjs",
    "test:media-runtime": "vitest run src/media-tools/media.runtime.test.ts --reporter=verbose",
    "test:model-runtime": "vitest run src/model/model.runtime.test.ts --reporter=verbose",
    "test:product-enrichment": "vitest run src/product-enrichment --reporter=verbose",
    "runtime:assemble": "node scripts/assemble-learned-runtime.mjs",
    "runtime:sync": "uv sync --project runtime --frozen"
  },
  "keywords": [],
  "author": "wzhic",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "43.4.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.149.1",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tdesign-react": "^1.18.2"
  }
}
