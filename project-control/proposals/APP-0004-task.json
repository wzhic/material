  "assumptions": [
    {"id": "APP-0004-ASM-001", "statement": "V1 单次只导入一个本地视频或一张本地图片；组图与批量分析均不进入本需求。", "status": "confirmed", "source": "用户明确单次一个文件，并将组图优先级调低"},
    {"id": "APP-0004-ASM-002", "statement": "V1 覆盖服饰和所有游戏；导入时选择行业，服饰目标固定为下单转化，游戏由素材场景判断拉新或拉活。", "status": "confirmed", "source": "用户逐项确认行业和转化目标边界"},
    {"id": "APP-0004-ASM-003", "statement": "视频同时支持脚本解析和大模型解析，最终只向用户输出一份融合报告；内部执行拓扑不在报告中公开。", "status": "confirmed", "source": "用户确认双方向解析、融合报告和不公开内部细节"},
    {"id": "APP-0004-ASM-004", "statement": "分析维度包含脚本结构、镜头、画面、字幕、口播、声音、商品或玩法、卖点、情绪、CTA、标签、问题诊断、优化建议和动态评分。", "status": "confirmed", "source": "用户明确完整分析维度并补充评分与标签"},
    {"id": "APP-0004-ASM-005", "statement": "分析页面支持源素材播放器、可调布局、多轨时间轴、时间点或时间段引用，以及贯穿全片的情绪变化曲线。", "status": "confirmed", "source": "用户持续核对并调整当前交互原型"},
    {"id": "APP-0004-ASM-006", "statement": "报告生成后先展示预览；用户确认后才保存分析记录并关联本地素材，拒绝时可指出问题后重新分析。", "status": "confirmed", "source": "用户明确简化报告确认与重新分析链路"},
    {"id": "APP-0004-ASM-007", "statement": "模型仅使用用户自带 API Key，凭据长期保存在系统安全存储并可删除；同一任务不自动切换模型。", "status": "confirmed", "source": "用户重新确认模型授权、持久化和切换边界"},
    {"id": "APP-0004-ASM-008", "statement": "分析运行时可调用第三方工具和自研工具、脚本、Skill；能力通过可替换合同接入，不与单个模型或硬编码流程绑定。", "status": "confirmed", "source": "用户补充外挂工具和自研 tools 范围"},
    {"id": "APP-0004-ASM-009", "statement": "素材文件不复制到应用数据或云端；正式保存的是分析记录、报告和必要的本地素材关联信息。", "status": "confirmed", "source": "用户明确素材只保存在本地电脑且应用不保存素材"},
    {"id": "APP-0004-ASM-010", "statement": "行业模板、固定加动态标签和评分机制按行业隔离并支持版本化调整；V1 不提供页面权重滑杆或用户模板编辑器。", "status": "confirmed", "source": "用户确认模板评分行业隔离、动态调整和反馈调权语义"}
