  "assumptions": [
    {
      "id": "APP-0022-ASM-001",
      "source": "用户明确要求接入 Codex SDK 并直接使用其 Codex 订阅",
      "statement": "本任务使用官方 @openai/codex-sdk，并以 Sign in with ChatGPT 作为订阅认证方式；API Key 与 ChatGPT 订阅是两个独立来源，不互相回退或静默切换。",
      "status": "confirmed"
    },
    {
      "id": "APP-0022-ASM-002",
      "source": "OpenAI 官方 Codex Auth 与 App Server 文档",
      "statement": "ChatGPT 托管认证由 Codex 运行时持久化并刷新令牌；Material 不读取、复制、回传或记录原始令牌，只消费非秘密账号、套餐、登录状态和限额摘要。",
      "status": "confirmed"
    },
    {
      "id": "APP-0022-ASM-003",
      "source": "安全隔离与共享登录副作用评估",
      "statement": "生产实现使用 app userData 下的隔离 CODEX_HOME，不自动复用 ~/.codex/auth.json，也不继承全局 config、AGENTS、MCP 或技能；因此首次使用需要在应用内完成一次 ChatGPT 登录，退出只影响 Material 的隔离会话。",
      "status": "confirmed"
    },
    {
      "id": "APP-0022-ASM-004",
      "source": "现有 APP-0020 模型测试与分析接线边界",
      "statement": "本任务提供模型发现、选择和显式固定文本测试，测试前提示会消耗 Codex 订阅额度且不发送素材；完整素材分析、报告生成和历史记录接线继续作为独立后续任务。",
      "status": "confirmed"
    },
    {
      "id": "APP-0022-ASM-005",
      "source": "OpenAI 官方定价与订阅说明",
      "statement": "界面只显示 Codex 返回的套餐与限额信息，不承诺无限用量；ChatGPT 订阅用量与 API Key 按量计费必须明确区分。",
      "status": "confirmed"
    },
    {
      "id": "APP-0022-ASM-006",
      "source": "测试数据外发和当前本机登录状态",
      "statement": "自动化用受控假 App Server/SDK 适配器验证协议和状态机；除非用户在应用内明确确认测试，本任务不会自动使用其现有全局 Codex 登录或消耗真实订阅额度。",
      "status": "confirmed"
    }
