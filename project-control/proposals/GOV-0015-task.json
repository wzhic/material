    "python3 tools/governance/taskctl.py run-required GOV-0015",
    "python3 tools/governance/taskctl.py commit-task GOV-0015",
    "python3 tools/governance/taskctl.py push-task GOV-0015",
    "python3 tools/governance/taskctl.py open-pr GOV-0015"
  ],
  "allowed_tools": ["apply_patch", "ApplyPatch", "Bash", "Read", "Glob", "Grep"],
