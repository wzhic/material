  "assumptions": [
    {
      "id": "GOV-0015-ASM-001",
      "statement": "一个直接后继 PR 的合并提交第一父提交精确表示该后继任务被合并时的目标分支状态，可作为其内部 base-sync merge 的递归信任锚。",
      "status": "confirmed",
      "source": "PR #2 Run 32636068170 与 Git merge 提交模型"
    },
    {
      "id": "GOV-0015-ASM-002",
      "statement": "递归锚点不跨越直接后继合并边界；普通提交、非干净 merge、错误第二父提交和范围外路径继续失败关闭。",
