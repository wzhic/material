    "project-control/**",
    "tools/governance/reconcile.py",
    "tools/governance/tests/test_stack_merge_evidence.py"
  ],
  "allowed_commands": [
    "python3 tools/governance/taskctl.py current --json",
    "python3 tools/governance/reconcile.py session --json",
    "python3 tools/governance/reconcile.py static --json",
