    {
      "id": "APP-0007-ASM-001",
      "source": "产品库本地优先、安全 IPC 与用户不写代码的约束",
      "statement": "备份只写入应用管理的数据目录并使用不可猜测 ID；renderer 只能看到创建时间、大小、schema、产品数和备份类型，不能看到或提交任意文件路径。",
      "status": "confirmed"
    },
    {
      "id": "APP-0007-ASM-002",
      "source": "产品库 PRD 的备份恢复与破坏性操作确认边界",
      "statement": "恢复属于影响现有本地产品数据的操作，必须在 UI 显示备份时间、产品数和影响并由用户二次确认；恢复前自动创建并验证安全备份，失败恢复原库。",
      "status": "confirmed"
    },
    {
      "id": "APP-0007-ASM-003",
      "source": "当前无用户确认的保留数量或期限",
      "statement": "V1 不自动清理备份，避免未定义保留策略造成数据丢失；备份删除和配额治理进入后续独立需求。",
      "status": "confirmed"
    },
    {
      "id": "APP-0007-ASM-004",
      "source": "产品库 PRD O-09 与第 16.1 节",
      "statement": "10,000 条与 P95 1 秒按产品库 PRD 作为工程验证基线，测试保留原始样本摘要；macOS 结果不替代 Windows 真机性能验收。",
      "status": "confirmed"
    }
  ],
