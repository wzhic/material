    },
    {
      "id": "APP-0008-ASM-002",
      "source": "单素材分析 PRD 的不可变报告和反馈分离合同",
      "statement": "报告、规则、产品和素材引用按确认时版本化 JSON 快照保留并禁止原地修改；可信反馈独立更新，不重算素材评分。",
      "status": "confirmed"
    },
    {
      "id": "APP-0008-ASM-003",
      "source": "素材保留在用户本地原位置和工作包范围隔离",
      "statement": "本任务不复制素材字节或持久化缩略图；在本地素材句柄能力接入前，记录只保存可安全展示的引用快照，播放和重新定位继续延期。",
      "status": "confirmed"
    },
    {
      "id": "APP-0008-ASM-004",
      "source": "单素材分析 PRD 10.15.4",
      "statement": "来源记录删除不级联删除后续记录；关系查询显示来源已删除，后续记录因自包含快照仍可读。",
      "status": "confirmed"
    }
